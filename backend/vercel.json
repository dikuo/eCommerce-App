  {
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "dist/**"
                ]
            }
        }, 
        {
            "src": "api/inventory.go",
            "use": "@vercel/go"
        }
    ],
    "routes": [
        {
            "src": "/api/inventory/(.*)",
            "dest": "api/inventory.go?id=$1"
        },
        {
            "src": "/(.*)",
            "dest": "server.js"
        }
    ]
}